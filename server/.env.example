PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/sportsync
JWT_SECRET=sportsync_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cloudinary Setup (Optional for dev mock)
CLOUDINARY_CLOUD_NAME=sportsync_demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# SMTP Email Setup (Optional for dev mock)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@sportsync.org
SMTP_PASS=app_password_here

# Global Sports News Provider Configuration
# Optional: Set an API key if using an external provider like NewsAPI or GNews.
# If omitted or exhausted, SportSync seamlessly falls back to real-time syndicated feeds (BBC Sport, ESPN, Sky Sports).
SPORTS_NEWS_API_KEY=your_api_key_here
SPORTS_NEWS_API_BASE_URL=https://newsapi.org/v2
SPORTS_NEWS_PROVIDER=newsapi
NEWS_CACHE_TTL=900000
